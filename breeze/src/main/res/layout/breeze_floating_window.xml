<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/breeze_floating_window_background"
    android:elevation="8dp"
    android:padding="12dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/breeze_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/breeze_drag_handle_bg" />

    <!-- Tone Chips (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/breeze_tone_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/breeze_tone_casual"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Casual"
                android:textSize="12sp"
                android:textColor="#333333"
                android:background="@drawable/breeze_tone_chip_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/breeze_tone_formal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Formal"
                android:textSize="12sp"
                android:textColor="#333333"
                android:background="@drawable/breeze_tone_chip_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/breeze_tone_friendly"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Friendly"
                android:textSize="12sp"
                android:textColor="#333333"
                android:background="@drawable/breeze_tone_chip_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/breeze_tone_concise"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Concise"
                android:textSize="12sp"
                android:textColor="#333333"
                android:background="@drawable/breeze_tone_chip_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/breeze_tone_professional"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Professional"
                android:textSize="12sp"
                android:textColor="#333333"
                android:background="@drawable/breeze_tone_chip_background" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Conversation History Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conversation"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/breeze_conversation_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="80dp"
        android:maxHeight="150dp"
        android:background="@drawable/breeze_tone_chip_background"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/breeze_conversation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Draft Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Draft"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/breeze_draft_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="@drawable/breeze_tone_chip_background"
            android:padding="12dp"
            android:paddingBottom="44dp"
            android:hint="Charles will suggest a draft here..."
            android:textColorHint="#80000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:scrollbars="vertical" />

        <!-- Submit Button (Accept Draft) -->
        <ImageButton
            android:id="@+id/breeze_draft_submit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/breeze_tone_chip_background_selected"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_check_24"
            app:tint="#FFFFFF"
            android:contentDescription="Accept draft" />
    </FrameLayout>

    <!-- Input Section (Ask Charles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/breeze_chat_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/breeze_tone_chip_background"
            android:paddingHorizontal="12dp"
            android:hint="Ask Charles..."
            android:textColorHint="#80000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/breeze_chat_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/breeze_tone_chip_background_selected"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_send_24"
            app:tint="#FFFFFF"
            android:contentDescription="Send to Charles" />
    </LinearLayout>

</LinearLayout>
