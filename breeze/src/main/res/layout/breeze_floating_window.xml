<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/breeze_floating_window_background"
    android:elevation="8dp">

    <!-- Corner Resize Handles (transparent touch areas) -->
    <View
        android:id="@+id/breeze_resize_top_left"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start" />

    <View
        android:id="@+id/breeze_resize_top_right"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end" />

    <View
        android:id="@+id/breeze_resize_bottom_left"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start" />

    <View
        android:id="@+id/breeze_resize_bottom_right"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end" />

    <!-- Close Button (Top-Right) -->
    <ImageButton
        android:id="@+id/breeze_close_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/breeze_close_button_background"
        android:scaleType="centerInside"
        android:padding="6dp"
        android:src="@drawable/ic_close_24"
        android:contentDescription="Close"
        android:elevation="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/breeze_drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/breeze_drag_handle_bg" />

        <!-- Tone Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/breeze_tone_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/breeze_tone_history"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="HistoryInJson"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/breeze_tone_formal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Formal"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/breeze_tone_friendly"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Friendly"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/breeze_tone_clarity"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Clarity"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/breeze_tone_shorten"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Shorten"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/breeze_tone_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="Expand"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/breeze_tone_chip_background" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Conversation History Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversation"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Conversation container with TTS button overlay -->
        <FrameLayout
            android:id="@+id/breeze_conversation_wrapper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp">

            <ScrollView
                android:id="@+id/breeze_conversation_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/breeze_section_background"
                android:padding="8dp"
                android:paddingBottom="44dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/breeze_conversation_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- TTS Button - bottom right corner like Accept button -->
            <TextView
                android:id="@+id/breeze_tts_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:gravity="center"
                android:text="🔊"
                android:textSize="20sp"
                android:background="@drawable/breeze_tts_button_background"
                android:elevation="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Draft Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Draft"
                android:textSize="12sp"
                android:textColor="#666666"
                android:textStyle="bold" />

            <!-- Stop/Cancel Button (visible during streaming) -->
            <TextView
                android:id="@+id/breeze_stop_button"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="⏹ Stop"
                android:textColor="#FF5722"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/breeze_stop_button_background"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/breeze_draft_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/breeze_draft_field"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/breeze_input_background"
                android:padding="12dp"
                android:paddingBottom="44dp"
                android:hint="Charles will suggest a draft here..."
                android:textColorHint="#80000000"
                android:textColor="#000000"
                android:textSize="14sp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

            <!-- Submit Button (Accept Draft) -->
            <TextView
                android:id="@+id/breeze_draft_submit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:text="Accept"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/breeze_accept_button_background" />
        </FrameLayout>

        <!-- Input Section Container (switches between normal and recording states) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Normal Input State (Ask Charles) -->
            <LinearLayout
                android:id="@+id/breeze_input_normal_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <EditText
                    android:id="@+id/breeze_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/breeze_input_background"
                    android:paddingHorizontal="12dp"
                    android:hint="Ask Charles..."
                    android:textColorHint="#80000000"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:imeOptions="actionSend"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/breeze_chat_send"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/breeze_mic_button_background"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:src="@drawable/breeze_rainbow_mic"
                    android:contentDescription="Voice or Send to Charles" />
            </LinearLayout>

            <!-- Recording State (replaces normal input during recording) -->
            <LinearLayout
                android:id="@+id/breeze_input_recording_state"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/breeze_recording_button_background"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <!-- Recording indicator with pulse -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp">

                    <!-- Pulsing background -->
                    <View
                        android:id="@+id/breeze_chat_recording_pulse"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/breeze_recording_pulse_bg" />

                    <!-- Recording indicator -->
                    <View
                        android:id="@+id/breeze_chat_recording_indicator"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:background="@drawable/breeze_recording_indicator_bg" />

                    <!-- Mic icon -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/breeze_rainbow_mic"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to stop"
                    android:textColor="#FF5722"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
