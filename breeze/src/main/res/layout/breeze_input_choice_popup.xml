<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/breeze_floating_window_background"
    android:elevation="8dp"
    android:padding="12dp">

    <!-- State 1: Initial Choice (Voice vs Text) -->
    <LinearLayout
        android:id="@+id/breeze_state_choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="visible">

        <!-- Voice Input (Primary) - Orange border with rainbow mic inside -->
        <FrameLayout
            android:id="@+id/breeze_choice_voice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/breeze_choice_button_primary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/breeze_rainbow_mic"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Text Input (Secondary) -->
        <FrameLayout
            android:id="@+id/breeze_choice_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/breeze_tone_chip_background"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_keyboard_24"
                app:tint="#49454F" />
        </FrameLayout>
    </LinearLayout>

    <!-- State 2: Text Input Mode -->
    <LinearLayout
        android:id="@+id/breeze_state_text_input"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/breeze_text_input_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tell Charles..."
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/breeze_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="@drawable/breeze_tone_chip_background"
            android:padding="12dp"
            android:paddingBottom="48dp"
            android:hint="Type your message..."
            android:textColorHint="#80000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:scrollbars="vertical" />

        <!-- Send Button (bottom-right, overlapping EditText) -->
        <ImageButton
            android:id="@+id/breeze_text_send"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="-44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/breeze_send_button_disabled"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_send_24"
            android:contentDescription="Send" />
    </LinearLayout>

    <!-- State 3: Recording Mode -->
    <LinearLayout
        android:id="@+id/breeze_state_recording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="150dp"
        android:padding="16dp">

        <!-- Recording Button with Animation -->
        <FrameLayout
            android:id="@+id/breeze_recording_button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Pulsing background circle -->
            <View
                android:id="@+id/breeze_recording_pulse"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/breeze_recording_pulse_bg" />

            <!-- Recording indicator circle -->
            <View
                android:id="@+id/breeze_recording_indicator"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/breeze_recording_indicator_bg" />

            <!-- Mic icon -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/breeze_rainbow_mic"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap to stop"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State 4: Processing Mode (Charles is working...) -->
    <LinearLayout
        android:id="@+id/breeze_state_processing"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp">

        <!-- Header row with progress indicator and cancel/check -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Progress indicator -->
            <ProgressBar
                android:id="@+id/breeze_processing_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#FF9800" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Charles is working..."
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- FrameLayout to hold either cancel button OR check icon (never both) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="28dp">

                <!-- Cancel button (text, shown during processing) -->
                <TextView
                    android:id="@+id/breeze_processing_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="#FF9800"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp" />

                <!-- Check icon (shown on success, replaces cancel button) -->
                <ImageView
                    android:id="@+id/breeze_processing_check"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/breeze_send_button_background"
                    android:scaleType="centerInside"
                    android:padding="4dp"
                    android:src="@drawable/ic_check_24"
                    android:visibility="gone"
                    android:contentDescription="Success" />
            </FrameLayout>
        </LinearLayout>

        <!-- Scrollable response preview -->
        <ScrollView
            android:id="@+id/breeze_processing_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:background="@drawable/breeze_tone_chip_background"
            android:padding="8dp">

            <TextView
                android:id="@+id/breeze_processing_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#333333"
                android:textSize="14sp" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
